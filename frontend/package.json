{
  "name": "champagnefestival",
  "version": "2026.11.1",
  "private": true,
  "description": "Champagnefestival website using React, Tailwind and Base UI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync-version": "node scripts/sync-version.mjs",
    "generate-seo": "node scripts/generate-seo-files.mjs",
    "build": "pnpm sync-version && pnpm generate-seo && pnpm paraglide:compile && tsc -b && vite build && vite build --config vite.sw.config.ts",
    "preview": "vite preview",
    "typecheck": "pnpm paraglide:compile && tsc -b --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:repo": "cd .. && frontend/node_modules/.bin/oxfmt -c frontend/.oxfmtrc.json .github scripts *.json",
    "format:repo:check": "cd .. && frontend/node_modules/.bin/oxfmt --check -c frontend/.oxfmtrc.json .github scripts *.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "check-message-parity": "node scripts/check-message-parity.mjs",
    "locale:audit": "node scripts/locale-audit.mjs",
    "bundle:check": "node scripts/bundle-budget.mjs --check",
    "ui:check": "node scripts/ui-maintenance.mjs check && node scripts/ui-imports.mjs",
    "ui:upstream": "node scripts/ui-maintenance.mjs upstream",
    "ui:diff": "node scripts/ui-maintenance.mjs diff",
    "ui:record": "node scripts/ui-maintenance.mjs record",
    "ui:test": "node --test scripts/ui-maintenance.verify.mjs scripts/ui-imports.verify.mjs",
    "ui:usage": "node scripts/ui-imports.mjs",
    "bundle:report": "node scripts/bundle-budget.mjs",
    "bundle:test": "node --test scripts/bundle-budget.verify.mjs",
    "test:compatibility:runtime": "vitest run -c vitest.redact.config.ts",
    "test:compatibility:browsers": "playwright test -c playwright.compatibility.config.ts",
    "test:compatibility": "pnpm test:compatibility:runtime && pnpm test:compatibility:browsers"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/dom": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@tanstack/charts": "^1.4.0",
    "@tanstack/db": "1.0.0-rc.1.3",
    "@tanstack/query-db-collection": "^1.5.1",
    "@tanstack/query-persist-client-core": "^5.107.1",
    "@tanstack/react-db": "1.0.0-rc.1.3",
    "@tanstack/react-form": "2.0.0-alpha.3",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dayjs": "^1.11.23",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "oidc-client-ts": "^3.5.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-leaflet": "^5.0.0",
    "react-oidc-context": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@inlang/paraglide-js": "^3.2.0",
    "@inlang/plugin-m-function-matcher": "^2.4.3",
    "@inlang/plugin-message-format": "^4.6.0",
    "@playwright/test": "^1.65.0",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/redact": "0.3.1",
    "@tanstack/table-core": "9.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/ui": "^5.1.0",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "jest-axe": "^11.0.0",
    "msw": "^3.0.4",
    "oxc-parser": "^0.157.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
