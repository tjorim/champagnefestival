{
  "name": "champagnefestival",
  "version": "2026.8.2",
  "private": true,
  "description": "Champagnefestival website using React, Tailwind and Base UI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync-version": "node scripts/sync-version.mjs",
    "generate-seo": "node scripts/generate-seo-files.mjs",
    "build": "pnpm sync-version && pnpm generate-seo && pnpm paraglide:compile && tsc -b && vite build && vite build --config vite.sw.config.ts",
    "preview": "vite preview",
    "typecheck": "pnpm paraglide:compile && tsc -b --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@tanstack/charts": "^1.0.0",
    "@tanstack/query-db-collection": "^1.3.5",
    "@tanstack/query-persist-client-core": "5.104.1",
    "@tanstack/react-db": "^0.5.4",
    "@tanstack/react-form": "2.0.0-alpha.2",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "9.2.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dayjs": "^1.11.23",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.49.0",
    "oidc-client-ts": "^3.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-leaflet": "^5.0.0",
    "react-oidc-context": "^3.2.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.26.0",
    "@inlang/plugin-m-function-matcher": "^2.2.17",
    "@inlang/plugin-message-format": "^4.4.5",
    "@playwright/test": "^1.63.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/table-core": "9.2.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.3",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "jest-axe": "^11.0.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
