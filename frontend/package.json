{
  "name": "champagnefestival",
  "version": "2026.8.2",
  "private": true,
  "description": "Champagnefestival website using React and Bootstrap",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync-version": "node scripts/sync-version.mjs",
    "generate-seo": "node scripts/generate-seo-files.mjs",
    "build": "pnpm sync-version && pnpm generate-seo && pnpm paraglide:compile && tsc -b && vite build && vite build --config vite.sw.config.ts",
    "preview": "vite preview",
    "typecheck": "pnpm paraglide:compile && tsc -b --noEmit",
    "lint": "pnpm generate-legacy-classes && oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "generate-legacy-classes": "node scripts/generate-legacy-classes.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@tanstack/charts": "^0.18.0",
    "@tanstack/query-db-collection": "^1.2.15",
    "@tanstack/react-db": "^0.4.1",
    "@tanstack/react-form": "2.0.0-alpha.2",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-table": "9.2.4",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dayjs": "^1.11.23",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "oidc-client-ts": "^3.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-bootstrap": "^3.0.0-beta.5",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-leaflet": "^5.0.0",
    "react-oidc-context": "^3.2.0",
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-m-function-matcher": "^2.2.16",
    "@inlang/plugin-message-format": "^4.4.4",
    "@playwright/test": "^1.63.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/table-core": "9.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.1",
    "happy-dom": "^20.14.5",
    "jest-axe": "^11.0.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
