# The backend image builds from the repository root (docker-compose.yml: context `.`, dockerfile `backend/Dockerfile`)
# because it copies /VERSION next to backend/. Docker reads this file from the context root only, so keep the context to
# what the Dockerfile copies (backend/ and VERSION).
.git/
.github/
android/
pebble/
frontend/
docs/
infra/
scripts/
.venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
**/node_modules/
backend/tests/
backend/uploads/
**/*.db
**/*.db-shm
**/*.db-wal
**/.env
**/.env.*
!**/.env.example
**/.coverage
**/coverage/
