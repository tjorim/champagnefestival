{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tjorim/renovate-config",
    "github>tjorim/renovate-config:js",
    "github>tjorim/renovate-config:python",
    "github>tjorim/renovate-config:android"
  ],
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["jest-axe", "@types/jest-axe"],
      "groupName": "jest-axe"
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["dayjs"],
      "groupName": "dayjs"
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["leaflet", "react-leaflet", "@types/leaflet"],
      "groupName": "maps"
    },
    {
      "description": [
        "dnd-kit packages share internal deps; mismatched versions cause type errors"
      ],
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@dnd-kit/*"],
      "groupName": "dnd-kit"
    },
    {
      "description": ["frontend/**"],
      "matchDatasources": ["npm"],
      "matchFileNames": ["frontend/**"],
      "addLabels": ["platform:frontend"]
    },
    {
      "description": ["pebble/**"],
      "matchDatasources": ["npm"],
      "matchFileNames": ["pebble/**"],
      "addLabels": ["platform:pebble"],
      "commitMessagePrefix": "deps(pebble):"
    },
    {
      "description": ["backend/**"],
      "matchDatasources": ["pypi"],
      "matchFileNames": ["backend/**"],
      "addLabels": ["platform:backend"],
      "commitMessagePrefix": "deps(backend):"
    },
    {
      "description": ["android/**"],
      "matchManagers": ["gradle"],
      "matchFileNames": ["android/**"],
      "addLabels": ["platform:android"],
      "commitMessagePrefix": "deps(android):"
    },
    {
      "description": [
        "query-db-collection 1.5 needs @tanstack/db 1.0 (it peers on ^1.0.0-rc.0), while this app is on db 0.15 and react-db 0.5, so the bump breaks the collection types. Remove this rule when db and react-db are migrated to 1.0, as worktime did."
      ],
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@tanstack/query-db-collection"],
      "allowedVersions": "<1.5.0"
    }
  ]
}
